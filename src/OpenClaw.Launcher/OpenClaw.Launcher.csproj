<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAuditMode>all</NuGetAuditMode>
    <AssemblyName>openclaw</AssemblyName>
    <RootNamespace>OpenClaw.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <UseAppHost Condition="'$(RuntimeIdentifier)' != ''">true</UseAppHost>
    <EnableMSIXTooling Condition="'$(IncludePackagingContent)' == 'true'">true</EnableMSIXTooling>
    <WindowsPackageType Condition="'$(IncludePackagingContent)' == 'true'">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(IncludePackagingContent)' != 'true'">None</WindowsPackageType>
    <GenerateAppxPackageOnBuild Condition="'$(IncludePackagingContent)' == 'true'">true</GenerateAppxPackageOnBuild>
    <GenerateAppxPackageOnBuild Condition="'$(IncludePackagingContent)' != 'true'">false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <IncludeProjectPriFile>false</IncludeProjectPriFile>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <WindowsAppSdkSelfContained Condition="'$(IncludePackagingContent)' == 'true'">true</WindowsAppSdkSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludePackagingContent)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludePackagingContent)' != 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.Base"
                      ExcludeAssets="all"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools"
                      ExcludeAssets="all"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Images\**\*.png" />
    <InternalsVisibleTo Include="OpenClaw.Launcher.Tests" />
    <InternalsVisibleTo Include="OpenClaw.Launcher.AotSmoke" />
  </ItemGroup>

  <Target Name="GenerateVersionedAppxManifest"
          BeforeTargets="_ValidatePresenceOfAppxManifestItems"
          Condition="'$(PackageIdentityVersion)' != ''">
    <PropertyGroup>
      <_GeneratedAppxManifest>$(IntermediateOutputPath)Package.g.appxmanifest</_GeneratedAppxManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="@(AppxManifest)"
          DestinationFiles="$(_GeneratedAppxManifest)" />
    <XmlPoke XmlInputPath="$(_GeneratedAppxManifest)"
             Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version"
             Value="$(PackageIdentityVersion)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_GeneratedAppxManifest)">
        <SubType>Designer</SubType>
      </AppxManifest>
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="'$(IncludePackagingContent)' == 'true'">
    <MxcRuntimeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</MxcRuntimeArchitecture>
    <MxcRuntimeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</MxcRuntimeArchitecture>
    <MxcRuntimeContentDirectory>$(MSBuildThisFileDirectory)..\..\content\mxc\$(MxcRuntimeArchitecture)\</MxcRuntimeContentDirectory>
    <SessionHostContentDirectory>$(MSBuildThisFileDirectory)..\..\content\session-host\$(MxcRuntimeArchitecture)\</SessionHostContentDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludePackagingContent)' == 'true'">
    <Content Include="$(MSBuildThisFileDirectory)..\..\content\openclaw\app\**\*"
             Link="app\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\content\openclaw\payload-files.json"
             Link="payload\payload-files.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\content\openclaw\runtime\$(NodeRuntimeArchiveFileName)"
             Condition="'$(NodeRuntimeArchiveFileName)' != ''"
             Link="runtime\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MxcRuntimeContentDirectory)**\*"
             Link="mxc\$(MxcRuntimeArchitecture)\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(SessionHostContentDirectory)**\*"
             Exclude="$(SessionHostContentDirectory)**\*.pdb;$(SessionHostContentDirectory)**\*.xml"
             Link="session-host\$(MxcRuntimeArchitecture)\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidatePackagingContent"
          BeforeTargets="Build"
          Condition="'$(IncludePackagingContent)' == 'true'">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\content\openclaw\app\openclaw.mjs')"
           Text="Missing expanded OpenClaw application content." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\content\openclaw\payload-files.json')"
           Text="Missing content\openclaw\payload-files.json." />
    <Error Condition="'$(NodeRuntimeArchiveFileName)' == '' Or !Exists('$(MSBuildThisFileDirectory)..\..\content\openclaw\runtime\$(NodeRuntimeArchiveFileName)')"
           Text="Missing architecture-specific bundled Node.js archive." />
    <Error Condition="'$(MxcRuntimeArchitecture)' == ''"
           Text="Packaging requires RuntimeIdentifier win-x64 or win-arm64 to select the MXC runtime." />
    <Error Condition="!Exists('$(MxcRuntimeContentDirectory)wxc-exec.exe')"
           Text="Missing the staged MXC runtime. Run scripts\Get-MxcRuntime.ps1 -Architecture $(MxcRuntimeArchitecture)." />
    <Error Condition="!Exists('$(MxcRuntimeContentDirectory)mxc-runtime.json')"
           Text="Missing MXC runtime provenance. Run scripts\Get-MxcRuntime.ps1 -Architecture $(MxcRuntimeArchitecture)." />
    <Error Condition="!Exists('$(SessionHostContentDirectory)openclaw-session-host.exe')"
           Text="Missing the published isolated-session guest helper. scripts\Build-MSIX.ps1 stages it for $(MxcRuntimeArchitecture)." />
  </Target>

  <Target Name="FinalizeNativeAotPackagePayload"
          BeforeTargets="_GenerateAppxPackageRecipeFile"
          Condition="'$(IncludePackagingContent)' == 'true' And '$(PublishAot)' == 'true'">
    <ItemGroup>
      <!-- MrtCore adds this item even when PRI generation is disabled. -->
      <AppxPackagePayload Remove="@(AppxPackagePayload)"
                          Condition="'%(Filename)%(Extension)' == 'resources.pri' And !Exists('%(FullPath)')" />
      <AppxPackagePayload Remove="@(AppxPackagePayload)"
                          Condition="'%(TargetPath)' == 'openclaw.deps.json' Or '%(TargetPath)' == 'openclaw.runtimeconfig.json'" />
    </ItemGroup>
  </Target>

</Project>
