<Project>

  <PropertyGroup>
    <MSBuildProjectExtensionsPath Condition="'$(IncludePackagingContent)' == 'true'">$(MSBuildProjectDirectory)\obj\packaging\</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <!--
    Static analysis policy.

    This repository uses only the analyzers that ship with the pinned .NET SDK.
    `AnalysisMode=All` opts into the full CA rule set rather than the smaller
    default, and `EnforceCodeStyleInBuild` makes the IDE style rules run during
    a command-line build instead of only inside an editor.

    `EnforceCodeStyleInBuild` runs the IDE rules but does not set their
    severity. Severity lives in the root `.editorconfig`, which records the
    per-rule policy this repository arrived at one family at a time.

    `TreatWarningsAsErrors` closes the gate. The explicit per-rule `error`
    entries in `.editorconfig` remain as readable policy history; this switch
    is what catches warnings nobody has classified yet, including new compiler
    diagnostics and new analyzers introduced by a future SDK bump. When an SDK
    upgrade surfaces something new, that is a deliberate decision to make, not
    a warning to scroll past.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      NuGet audit diagnostics are excluded from the error gate. They are
      published vulnerability advisories, so a new one can appear against an
      unchanged dependency graph and would otherwise break `main` with no code
      change and no way to fix it in the failing build. They stay visible as
      warnings and are triaged as security work.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!--
      Build-time IDE0005 (unnecessary using directives) only reports when
      documentation generation is enabled. See dotnet/roslyn#41640. Generating
      documentation also turns on CS1591, which would demand XML comments on
      every symbol, so CS1591 is suppressed deliberately rather than satisfied
      with low-value comments.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
