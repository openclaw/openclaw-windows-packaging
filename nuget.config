<?xml version="1.0" encoding="utf-8"?>
<!--
  Spike-only feed configuration. Microsoft.Mxc.Sdk has not shipped, so the
  pinned package is a locally packed build restored from
  artifacts\mxc-sdk-feed. Replace the local source with the official feed when
  the package is published.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="mxc-sdk-local" value="artifacts/mxc-sdk-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="mxc-sdk-local">
      <package pattern="Microsoft.Mxc.Sdk" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
