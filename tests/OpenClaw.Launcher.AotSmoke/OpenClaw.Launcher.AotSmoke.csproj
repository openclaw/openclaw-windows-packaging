<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAuditMode>all</NuGetAuditMode>
    <AssemblyName>OpenClaw.Launcher.AotSmoke</AssemblyName>
    <RootNamespace>OpenClaw.Launcher.AotSmoke</RootNamespace>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <UseAppHost Condition="'$(RuntimeIdentifier)' != ''">true</UseAppHost>
    <IsPackable>false</IsPackable>

    <!--
      Deliberately different from the launcher's version. The version scenario
      asserts that the version option reports the launcher assembly, so an
      accidental return to the library's entry-assembly default is visible here.
    -->
    <Version>9.9.9.9</Version>
    <AssemblyVersion>9.9.9.9</AssemblyVersion>
    <FileVersion>9.9.9.9</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenClaw.Launcher\OpenClaw.Launcher.csproj" />
  </ItemGroup>

</Project>
